{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build the CUDA extension",
      "type": "shell",
      "command": "uv sync --extra cpu --reinstall-package scalingelections",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "Compiles scalingelections.cu through setup.py, against CUDA where nvcc is present"
    },
    {
      "label": "Build the Mojo artifacts",
      "type": "shell",
      "command": "pixi run build",
      "group": "build",
      "problemMatcher": [],
      "detail": "Writes build/scalingelections_mojo.so and build/scalingelections"
    },
    {
      "label": "Run the test suite",
      "type": "shell",
      "command": "uv run --no-sync pytest test.py -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "detail": "Cross-checks all three languages against oracles written from the definitions"
    }
  ]
}
